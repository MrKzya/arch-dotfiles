    layout {
        gaps 8 //16 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent" // Keep the wallpaper visible in the overview.

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
	
        }

        struts {}
    }
